{
  "name": "apache-shenyu-dashboard",
  "version": "2.2.1",
  "description": "Apache ShenYu Dashboard",
  "private": true,
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 8000",
    "start:no-proxy": "cross-env NO_PROXY=true vite --host 127.0.0.1 --port 8000",
    "build": "vite build && node scripts/verify-dist.mjs",
    "site": "npm run build && gh-pages -d dist",
    "analyze": "vite build --sourcemap",
    "lint:style": "stylelint \"src/**/*.less\"",
    "lint": "eslint --ext .js src tests && npm run lint:style",
    "lint:fix": "eslint --fix --ext .js src tests && npm run lint:style",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js",
    "test": "npm run test:unit --",
    "test:unit": "jest --runInBand",
    "test:component": "npm run test:unit -- src/components",
    "test:all": "npm run test:unit --",
    "test:coverage": "npm run test:unit -- --coverage",
    "test:watch": "npm run test:unit -- --watch",
    "prettier": "prettier --write ./src/**/**/**/*",
    "preview": "vite preview --host 127.0.0.1 --port 8000"
  },
  "dependencies": {
    "@ant-design/icons": "2.1.1",
    "@babel/polyfill": "^7.0.0-beta.36",
    "@douyinfe/semi-ui": "2.87.0",
    "@microlink/react-json-view": "1.31.50",
    "classnames": "^2.2.5",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.8.17",
    "dva-core": "2.0.4",
    "echarts": "^6.0.0",
    "enquire-js": "^0.2.1",
    "history": "^5.3.0",
    "lodash": "^4.18.1",
    "lodash-decorators": "^6.0.0",
    "moment": "^2.30.1",
    "omit.js": "^1.0.0",
    "path-to-regexp": "^3.3.0",
    "prop-types": "^15.5.10",
    "qs": "^6.16.1",
    "rc-drawer": "^7.1.0",
    "react": "18.3.1",
    "react-container-query": "0.13.0",
    "react-dom": "18.3.1",
    "react-intl-universal": "^2.4.2",
    "react-redux": "8.1.3",
    "react-resizable": "3.1.3",
    "react-router-dom": "^6.30.3",
    "redux": "4.2.1",
    "redux-logger": "^3.0.6",
    "redux-saga": "0.16.2",
    "setprototypeof": "^1.1.0",
    "url-polyfill": "^1.0.10",
    "whatwg-fetch": "3.6.20",
    "events": "3.3.0",
    "uuid": "3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-proposal-decorators": "7.28.0",
    "@babel/plugin-transform-class-properties": "7.28.6",
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-react": "7.28.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "babel-jest": "^29.7.0",
    "cross-env": "^5.1.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-compat": "^4.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-markdown": "^4.0.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "gh-pages": "^5.0.0",
    "husky": "^0.14.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "less": "4.4.2",
    "lint-staged": "^7.2.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.2.5",
    "pro-download": "^1.0.1",
    "react-loadable": "^5.4.0",
    "regenerator-runtime": "^0.12.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "vite": "7.3.8",
    "@babel/eslint-parser": "7.28.5"
  },
  "lint-staged": {
    "**/*.{js,jsx,less}": [
      "prettier --write",
      "git add"
    ],
    "**/*.{js,jsx}": "npm run lint-staged:js",
    "**/*.less": "stylelint"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ]
}
